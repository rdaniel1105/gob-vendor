# ZincSearch (optional — only needed if you persist results to ZincSearch)
ZINCSEARCH_URL=
ZINCSEARCH_USERNAME=
ZINCSEARCH_PASSWORD=

# HTTP client
HTTP_CLIENT_RETRIES=3
HTTP_CLIENT_TIMEOUT=30
HTTP_CLIENT_SKIP_VERIFY=false
HTTP_CLIENT_FORCE_ATTEMPT_HTTP2=false
FORCE_HTTPS_REDIRECT=false

# Optional outbound proxy (semicolon-separated list when rotation is enabled)
USE_PROXY_ROTATION=false
HTTP_PROXY_URL=
